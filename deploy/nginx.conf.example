# Reverse proxy for carousel-studio. Copy to your nginx sites-enabled dir,
# swap YOUR_DOMAIN, then `nginx -t && systemctl reload nginx`.
#
# 1. DNS: A-record YOUR_DOMAIN -> your server's public IP (must resolve
#    BEFORE requesting a cert).
# 2. cp deploy/nginx.conf.example /etc/nginx/sites-enabled/YOUR_DOMAIN
# 3. nginx -t
# 4. systemctl reload nginx
# 5. once DNS has propagated:
#    certbot --nginx -d YOUR_DOMAIN --agree-tos --redirect
#    (certbot rewrites this file in place to add the 443/ssl server block +
#    http->https redirect — no manual ssl_certificate lines needed)

server {
    listen 80;
    server_name YOUR_DOMAIN;
    client_max_body_size 20M;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location = / {
        return 302 /carousel/app;
    }

    location / {
        proxy_pass http://127.0.0.1:8055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
