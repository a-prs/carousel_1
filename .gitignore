# Secrets — never commit
.env
*.env
!*.env.example

# venv
.venv/

# SQLite DBs (also under data/, which is outside app dir)
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node / Vite
web/node_modules/
web/dist/

# Built SPA is regenerated by `npm run build`; keep it out of git
server/static-web/

# Ephemeral job files live outside the app dir, but ignore any stray copies
jobs/

# Per-client plaintext password dumps (written once by admin_cli seed helpers)
*_credentials.txt

# bun/npm local cache dirs
bun/
web/bun/

# Real nginx vhost (with your actual domain) — copy deploy/nginx.conf.example
# instead, keep the filled-in version out of git
nginx-*.conf
!deploy/nginx.conf.example
